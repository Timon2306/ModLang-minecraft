{
    "$schema":  "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName":  "ModLang",
    "version":  "1.1.0",
    "identifier":  "com.modlang.translator",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "ModLang вЂ” Minecraft Modpack Translator",
                                    "width":  1180,
                                    "height":  820,
                                    "minWidth":  960,
                                    "minHeight":  680,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "theme":  "Dark"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico",
                                "icons/icon.png"
                            ]
               }
}
