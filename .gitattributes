# Auto-detect text files and normalize line endings
* text=auto

# Explicitly force Unix LF for source files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.ico binary
*.exe binary
*.msi binary
*.7z binary
*.zip binary